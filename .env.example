SECRET_KEY=change-me

# The database the app runs against. A *_dev copy for development: the test
# suites and dbtool.py both refuse to write to anything that is not named
# *_dev unless you ask for live explicitly.
DATABASE_URL=postgresql://username:password@host:5432/dbname_dev

# Production. dbtool.py reads this only when --live is passed, and asks the
# server for current_database() rather than trusting the URL.
LIVE_DATABASE_URL=postgresql://username:password@host:5432/dbname

# For `python dbtool.py seed test-account`, which builds an account you can
# log in as with a friend, a hub and a room already set up. Both are read
# from here so that neither a real address nor a password is written down in
# a tracked file; the command refuses rather than guessing.
QA_FRIEND=someone@umb.edu
QA_PASSWORD=

# Set to true on a site served over https. It marks the session cookie
# Secure, which a browser then refuses to send over plain http -- so leaving
# it off for a local development server is deliberate, not an oversight.
# SameSite=Lax is set in code either way, and is what stops a cross-site
# POST arriving with your session attached.
SESSION_COOKIE_SECURE=

MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
