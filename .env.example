# Copy to .env and fill in. The same code runs in development and in
# production -- only these values differ.

SECRET_KEY=change-me

# The database this machine should use. On the live server that is the real
# database; on a development machine, point it at a copy.
#
# A database whose name ends in _dev is treated as a development database: the
# app shows which one it is on, and the test suites refuse to run against
# anything else. Production needs no setting for this -- whatever the live
# database is called, the app stays quiet.
#
# A DATABASE_URL already set in the shell OVERRIDES this value, because
# load_dotenv() does not overwrite variables that already exist. That is how a
# one-off command targets a different database without editing this file:
#     $env:DATABASE_URL = "postgresql://..."
DATABASE_URL=postgresql://username:password@host:5432/dbname

MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USE_SSL=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional, development only. Read by db/clone_dev_db.py, which copies the live
# database to <name>_dev; that script is not in this repository, so the live
# server does not need this key. It is kept separate from DATABASE_URL so that
# pointing DATABASE_URL at the copy cannot make the script clone the copy.
# LIVE_DATABASE_URL=postgresql://username:password@host:5432/dbname
